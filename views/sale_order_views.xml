<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_proforma_type" model="ir.ui.view">
        <field name="name">sale.order.form.proforma.type</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="proforma_type" widget="radio"
                       options="{'horizontal': true}"/>
                <field name="proforma_name"
                       invisible="proforma_type == 'sale'"
                       readonly="1"/>
                <field name="delivery_period_days"/>
            </xpath>
        </field>
    </record>
</odoo>
